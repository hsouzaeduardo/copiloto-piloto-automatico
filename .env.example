# Endpoint do projeto no Microsoft Foundry e nome do deployment do modelo
FOUNDRY_PROJECT_ENDPOINT=https://<recurso>.services.ai.azure.com/api/projects/<projeto>
FOUNDRY_MODEL=gpt-4o-mini

# 1 = aprovações pelo cockpit web (uvicorn cockpit.server:app). Vazio = aprovar no terminal.
COCKPIT=1

# Pausa (s) entre eventos nas demos, para o cockpit respirar na tela. 0 = sem pausa.
DEMO_RITMO=3
